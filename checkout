#!/usr/bin/bash
set -eo pipefail

## checkout - Materialize one quantization from a bare cache into a working tree
##  - REMOTE_ROOT: Path to the volume holding bare repositories
##  - NOMAD_META_REPO: Repository name; the bare repo is ${REMOTE_ROOT}/${NOMAD_META_REPO}
##  - NOMAD_META_INCLUDE  [optional]: LFS objects to checkout
##  - NOMAD_META_REF  [optional]: Branch, tag or sha to check out (default: origin/HEAD)
##  - GIT_LFS_PROGRESS  [optional]: Absolute path to log LFS progress to; sampled to stdout
##
## The working tree is created at ./${NOMAD_META_REPO}, under the image's WORKDIR (/models),
## and LFS objects are read from ${REMOTE_ROOT}/${NOMAD_META_REPO}/lfs, so that volume must
## be mounted read-write.
source /usr/share/git-xet/common.sh

[ -z "${REMOTE_ROOT:-}" ]            && fatal 400 "Missing required environment variable REMOTE_ROOT"
[ -z "${NOMAD_META_REPO:-}" ]   && fatal 400 "Missing required environment variable NOMAD_META_REPO"

git --version
git lfs --version

[ -d "${NOMAD_META_REPO}" ] || mkdir -p "${NOMAD_META_REPO}"
cd "${NOMAD_META_REPO}"

[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == "true" ] || git init

set_remote_url "origin" "${REMOTE_ROOT}/${NOMAD_META_REPO}"

## Copy LFS objects directly from the bare remote to the worktree instead of copying to .git/lfs/objects
## then a second time to the worktree
git config set lfs.storage "${REMOTE_ROOT}/${NOMAD_META_REPO}/lfs"

echo "[info] Fetching remote refs from ${REMOTE_ROOT}/${NOMAD_META_REPO}"
git fetch origin 2>&1

if [ -z "${NOMAD_META_REF:-}" ]; then
    NOMAD_META_REF=$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||')
    echo "[info] Using remote ref origin/HEAD -> $NOMAD_META_REF"
fi

if git rev-parse --verify --quiet "origin/${NOMAD_META_REF}" >/dev/null; then
    ## Check out a branch, fast-forward to updated remote HEAD
    GIT_LFS_SKIP_SMUDGE=1 git checkout -f -B "${NOMAD_META_REF}" "origin/${NOMAD_META_REF}"
else
    ## Checkout a tag or sha
    GIT_LFS_SKIP_SMUDGE=1 git checkout -f --detach "${NOMAD_META_REF}"
fi

trap cleanup EXIT
[ -n "${GIT_LFS_PROGRESS:-}" ] && progress

echo "[info] Checking out LFS objects [${NOMAD_META_INCLUDE:-all}]"
git lfs checkout ${NOMAD_META_INCLUDE} 2>&1
