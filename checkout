#!/usr/bin/bash
set -eo pipefail

## checkout - Materialize one quantization from a bare cache into a working tree
##  - REMOTE_ROOT: Path to the volume holding the bare repositories
##  - REPO_NAME: Repository name; the bare repo is ${REMOTE_ROOT}/${REPO_NAME}
##  - MODEL_QUANT: Quantization directory to materialize, e.g. UD-IQ2_M
##  - REPO_REF  [optional]: Branch, tag or sha to check out (default: origin/HEAD)
##  - GIT_LFS_PROGRESS  [optional]: Absolute path to log LFS progress to; sampled to stdout
##
## The working tree is created at ./${REPO_NAME}, under the image's WORKDIR (/models),
## and LFS objects are read from ${REMOTE_ROOT}/${REPO_NAME}/lfs, so that volume must
## be mounted read-write.

function fatal() {
    echo "[fatal $1] $2" >&2
    exit $1
}

function progress() {
    progress_file="$1"

    truncate -s 0 "$progress_file"
    trap 'rm -f -- "$progress_file"' EXIT

    ## Periodically tail and truncate the progress file
    while [ -f "$progress_file" ]; do
        tail -n 8 "$progress_file"
        truncate -s 0 "$progress_file"
        sleep 5
    done &
}

[ -z "${REMOTE_ROOT:-}" ] && fatal 400 "Missing required environment variable REMOTE_ROOT"
[ -z "${REPO_NAME:-}" ]   && fatal 400 "Missing required environment variable REPO_NAME"
[ -z "${MODEL_QUANT:-}" ] && fatal 400 "Missing required environment variable MODEL_QUANT"

git --version
git lfs --version
git xet --version

[ -d "${REPO_NAME}" ] || mkdir -p "${REPO_NAME}"
cd "${REPO_NAME}"

[ "$(git rev-parse  --is-inside-work-tree 2>/dev/null)" == "true" ] || git init

echo "[info] Checking remote"
if git remote get-url origin 2>/dev/null; then
    echo "[info] Setting remote URL to ${REMOTE_ROOT}/${REPO_NAME}"
    git remote set-url origin "${REMOTE_ROOT}/${REPO_NAME}"
else
    echo "[info] Adding remote at ${REMOTE_ROOT}/${REPO_NAME}"
    git remote add origin "${REMOTE_ROOT}/${REPO_NAME}"
fi

git config set lfs.storage "${REMOTE_ROOT}/${REPO_NAME}/lfs"

echo "[info] Fetching remote refs from ${REMOTE_ROOT}/${REPO_NAME}"
git fetch origin 2>&1

if [ -z "${REPO_REF:-}" ]; then
    REPO_REF=$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||')
    echo "[info] Using remote ref origin/HEAD -> $REPO_REF"
fi

if git rev-parse --verify --quiet "origin/${REPO_REF}" >/dev/null; then
    ## Check out a branch, fast-forward to updated remote HEAD
    GIT_LFS_SKIP_SMUDGE=1 git checkout -f -B "${REPO_REF}" "origin/${REPO_REF}"
else
    ## Checkout a tag or sha
    GIT_LFS_SKIP_SMUDGE=1 git checkout -f --detach "${REPO_REF}"
fi

[ -f "${MODEL_QUANT}"/*-00001-of-*.gguf ] || fatal 404 "Model does not appear to contain weights for quantization ${MODEL_QUANT}"
[ -n "${GIT_LFS_PROGRESS:-}" ] && progress "${GIT_LFS_PROGRESS}"

echo "[info] Fetching LFS objects for quant ${MODEL_QUANT}"
git lfs pull --include "${MODEL_QUANT}/*" --dry-run 2>&1
git lfs pull --include "${MODEL_QUANT}/*" 2>&1
