#!/usr/bin/bash
set -eo pipefail

## init - Setup a new local git repository with an origin remote
##  - NOMAD_META_REMOTE_URL: Remote git repository URL
##  - NOMAD_META_REPO: Local repository path
source /usr/share/git-xet/common.sh

[ -z "${NOMAD_META_REMOTE_URL:-}" ] && fatal 400 "Missing required environment variable NOMAD_META_REMOTE_URL"
[ -z "${NOMAD_META_REPO:-}" ]  && fatal 400 "Missing required environment variable NOMAD_META_REPO"

git --version
git lfs --version
git xet --version

[ -d "${NOMAD_META_REPO}" ] || mkdir -p "${NOMAD_META_REPO}"
cd "${NOMAD_META_REPO}"

[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == "true" ] || git init --bare

set_remote_url "origin" "${NOMAD_META_REMOTE_URL}"

echo "[info] Fetching remote refs from ${NOMAD_META_REMOTE_URL}"
git fetch origin 2>&1
