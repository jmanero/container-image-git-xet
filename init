#!/usr/bin/bash
set -eo pipefail

## init - Setup a new local git repository with an origin remote
##  - NOMAD_META_REMOTE_URL: Remote git repository URL
##  - NOMAD_META_REPO_NAME: Local repository path

function fatal() {
    echo "[fatal $1] $2" >&2
    exit $1
}

[ -z "${NOMAD_META_REMOTE_URL:-}" ] && fatal 400 "Missing required environment variable NOMAD_META_REMOTE_URL"
[ -z "${NOMAD_META_REPO_NAME:-}" ]  && fatal 400 "Missing required environment variable NOMAD_META_REPO_NAME"

git --version
git lfs --version
git xet --version

[ -d "${NOMAD_META_REPO_NAME}" ] || mkdir "${NOMAD_META_REPO_NAME}"
cd "${NOMAD_META_REPO_NAME}"

[ $(git rev-parse --is-bare-repository) == "true" ] || git init --bare

echo "[info] Checking remote"
if git remote get-url origin; then
    echo "[info] Setting remote URL to ${NOMAD_META_REMOTE_URL}"
    git remote set-url origin "${NOMAD_META_REMOTE_URL}"
else
    echo "[info] Adding remote at ${NOMAD_META_REMOTE_URL}"
    git remote add origin "${NOMAD_META_REMOTE_URL}"
fi

echo "[info] Fetching remote refs from ${NOMAD_META_REMOTE_URL}"
git fetch origin
