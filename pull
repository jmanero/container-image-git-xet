#!/usr/bin/bash
set -eo pipefail

## pull - Fetch a remote ref to the local bare repository
##  - NOMAD_META_REPO: Local repository path
##  - NOMAD_META_REF  [optional]: Reference to fetch into the local repository
source /usr/share/git-xet/common.sh

[ -z "${NOMAD_META_REPO:-}" ] && fatal 400 "Missing required environment variable NOMAD_META_REPO"
[ -d "${NOMAD_META_REPO}" ]   || fatal 404 "Repository at ${NOMAD_META_REPO} does not exist"

git --version
git lfs --version
git xet --version

cd "${NOMAD_META_REPO}"

if [ -z "${NOMAD_META_REF:-}" ]; then
    NOMAD_META_REF=$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||')
    echo "[info] Using remote ref origin/HEAD -> $NOMAD_META_REF"
fi

## Point HEAD at a real branch so that repos using us as a remote can resolve origin/HEAD. A tag or a sha should not be HEAD
if git rev-parse --verify --quiet "refs/remotes/origin/${NOMAD_META_REF}" >/dev/null; then
    git symbolic-ref HEAD "refs/heads/${NOMAD_META_REF}"
fi

echo "[info] Fetching diffs for ${NOMAD_META_REF} from remote"
git fetch origin "${NOMAD_META_REF}:${NOMAD_META_REF}" 2>&1
git show "${NOMAD_META_REF}" --name-only

trap cleanup EXIT
[ -n "${GIT_LFS_PROGRESS:-}" ] && progress

echo "[info] Fetching LFS objects for ref ${NOMAD_META_REF}"
git lfs fetch origin "${NOMAD_META_REF}" 2>&1
